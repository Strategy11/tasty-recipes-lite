{
    "name": "strategy11/tasty-recipes-lite",
    "description": "The most complete recipe plugin for WordPress.",
    "homepage": "https://github.com/Strategy11/tasty-recipes-lite",
    "license": "GPL-2.0-or-later",
    "authors": [
		{
			"name": "WP Tasty team",
			"email": "support@wptasty.com",
			"homepage": "https://wptasty.com"
		}
	],
    "type": "wordpress-plugin",
    "repositories":[
        {
          "type":"vcs",
          "url":"git@github.com:Strategy11/tasty-framework.git"
        }
    ],
    "require-dev": {
        "automattic/vipwpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0.0",
        "friendsofphp/php-cs-fixer": "^3.54",
        "masterminds/html5": "^2.7",
        "php-stubs/wordpress-stubs": "^6",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-strict-rules": "^1.5",
        "phpunit/phpunit": "^7.5.20 || ^8.5 || ^9",
        "querypath/querypath": "^3.0",
        "sirbrillig/phpcs-variable-analysis": "^2.5",
        "slevomat/coding-standard": "~8.0",
        "wp-cli/dist-archive-command": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "yoast/phpunit-polyfills": "^2",
        "yoast/wordpress-seo": "^23.0"
    },
    "extra": {
        "installer-paths": {
            "./inc/libs/tasty-framework/": ["strategy11/tasty-framework"],
            "vendor/{$name}/": ["type:wordpress-plugin"]
        }
    },
    "scripts": {
        "phpcs": "vendor/bin/phpcs --parallel=10 ./",
        "phpcbf": "vendor/bin/phpcbf",
        "phpunit": "vendor/bin/phpunit",
        "phpcsfixer": "vendor/bin/php-cs-fixer fix --dry-run --verbose",
        "phpstan": "vendor/bin/phpstan analyze ./ --memory-limit=2G",
        "replace-textdomain": "bin/replace-textdomain.sh",
        "post-install-cmd": [
            "composer replace-textdomain"
        ],
        "post-update-cmd": [
            "composer replace-textdomain"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/installers": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.0"
        },
        "sort-packages": true
    },
    "require": {
        "composer/installers": "^2.2",
        "strategy11/tasty-framework": "1.1.11"
    }
}
