{
  "name": "tasty-recipes-lite",
  "version": "1.0.0",
  "main": "Gruntfile.js",
  "author": "WP Tasty",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@wordpress/e2e-test-utils-playwright": "^1.47.0",
    "@wordpress/env": "^11.7.0",
    "@wordpress/scripts": "^32.3.0",
    "classnames": "^2.5.1",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-compat": "^6.2.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "39.9.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-jquery": "^2.7.0",
    "eslint-plugin-playwright": "^0.15.3",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-sonarjs": "0.23.0",
    "eslint-plugin-unicorn": "^54.0.0",
    "grunt": "^1.6.2",
    "grunt-text-replace": "^0.4.0",
    "ignore-emit-webpack-plugin": "^2.0.6",
    "svglint": "^4.2.1"
  },
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "dev": "npm run start",
    "watch": "npm run start",
    "prod": "npm run production",
    "production": "npm run build",
    "lint-svg": "cross-env svglint templates/designs/bold/images/*.svg templates/designs/fresh/images/*.svg assets/images/*.svg",
    "lint-js": "eslint assets/settings && eslint assets/block-editor && eslint tests/playwright",
    "lint": "npm run lint-svg && npm run lint-js",
    "lint-fix": "eslint assets/settings --fix && eslint assets/block-editor --fix && eslint tests/playwright --fix",
    "makepot": "php -d memory_limit=512M /usr/local/bin/wp i18n make-pot . languages/tasty-recipes.pot --skip-audit",
    "test:php": "composer phpunit",
    "zip": "bin/compile.sh",
    "sync-locks": "pnpm install && npm install --package-lock-only --legacy-peer-deps",
    "env": "wp-env",
    "e2e:run": "playwright test --config playwright.config.js",
    "e2e:githubrun": "playwright test --config playwright.config.js"
  },
  "dependencies": {
    "@uiw/react-color-chrome": "^2.10.3",
    "@wordpress/element": "^6.35.0",
    "@wordpress/hooks": "^4.35.0",
    "@wordpress/icons": "^13.2.0",
    "react-select": "^5.10.2"
  }
}
