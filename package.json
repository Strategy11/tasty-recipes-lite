{
  "name": "tasty-recipes-lite",
  "version": "1.0.0",
  "main": "Gruntfile.js",
  "author": "WP Tasty",
  "devDependencies": {
    "@10up/cypress-wp-utils": "^0.6.0",
    "@wordpress/env": "^10.36.0",
    "@wordpress/scripts": "^30.26.0",
    "classnames": "^2.5.1",
    "cross-env": "^10.0.0",
    "cypress": "^15.4.0",
    "cypress-file-upload": "^5.0.8",
    "eslint": "^8.57.0",
    "eslint-plugin-compat": "^6.1.0",
    "eslint-plugin-cypress": "^2.12.1",
    "eslint-plugin-import": "2.25.2",
    "eslint-plugin-jsdoc": "62.7.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-no-jquery": "^2.7.0",
    "eslint-plugin-prettier": "5.0.0",
    "eslint-plugin-react": "^7.20.6",
    "eslint-plugin-sonarjs": "0.23.0",
    "eslint-plugin-unicorn": "^54.0.0",
    "grunt": "^1.6.1",
    "grunt-text-replace": "^0.4",
    "ignore-emit-webpack-plugin": "^2.0.6",
    "svglint": "^4.1.1"
  },
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "dev": "npm run start",
    "watch": "npm run start",
    "prod": "npm run production",
    "production": "npm run build",
    "lint-svg": "cross-env svglint templates/designs/bold/images/*.svg templates/designs/fresh/images/*.svg assets/images/*.svg",
    "lint-js": "eslint assets/settings && eslint assets/block-editor",
    "lint": "npm run lint-svg && npm run lint-js",
    "lint-fix": "eslint assets/settings --fix && eslint assets/block-editor --fix",
    "makepot": "php -d memory_limit=512M /usr/local/bin/wp i18n make-pot . languages/tasty-recipes.pot --skip-audit",
    "test:php": "composer phpunit",
    "zip": "bin/compile.sh",
    "sync-locks": "pnpm install && npm install --package-lock-only",
    "env": "wp-env",
    "e2e:run": "cypress run --config-file cypress.config.js",
    "e2e:githubrun": "cypress run --config-file cypress.config.js --env TASTY_RECIPES=tasty-recipes"
  },
  "dependencies": {
    "@uiw/react-color-chrome": "^2.9.0",
    "@wordpress/icons": "^11.0.0",
    "react-select": "^5.10.2"
  }
}
