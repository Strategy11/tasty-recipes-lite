{
  "name": "tasty-recipes-lite",
  "version": "1.0.0",
  "main": "Gruntfile.js",
  "author": "WP Tasty",
  "devDependencies": {
    "@babel/core": "^7.20.12",
    "@babel/plugin-transform-runtime": "^7.19.6",
    "@babel/preset-env": "^7.20.2",
    "@vue/test-utils": "^1.3.3",
    "@wordpress/eslint-plugin": "^13.8.0",
    "autoprefixer": "^10.4.13",
    "babel-core": "^7.0.0-bridge.0",
    "babel-jest": "^29.2.2",
    "babel-loader": "^9.1.2",
    "babel-plugin-transform-react-jsx": "^6.24.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.31.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^27.2.1",
    "eslint-plugin-vue": "^9.7.0",
    "grunt": "^1.5.3",
    "grunt-text-replace": "^0.4.0",
    "grunt-wp-readme-to-markdown": "^2.1.0",
    "jest": "^29.3.1",
    "jest-environment-jsdom": "^29.2.0",
    "laravel-mix": "^6.0.49",
    "postcss": "^8.4.21",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.57.1",
    "sass-loader": "^13.2.0",
    "style-loader": "^3.3.1",
    "svglint": "^2.2.0",
    "vue-jest": "^3.0.7",
    "vue-loader": "^15.9.8",
    "vue-template-compiler": "^2.7.4",
    "webpack": "^5.75.0",
    "webpack-notifier": "^1.15.0"
  },
  "scripts": {
    "build": "npm run prod",
    "dev": "npm run development",
    "development": "cross-env NODE_ENV=development node_modules/webpack/bin/webpack.js --progress --config=node_modules/laravel-mix/setup/webpack.config.js",
    "watch": "npm run development -- --watch",
    "hot": "cross-env NODE_ENV=development node_modules/webpack-dev-server/bin/webpack-dev-server.js --inline --hot --config=node_modules/laravel-mix/setup/webpack.config.js",
    "prod": "npm run production",
    "production": "cross-env NODE_ENV=production node_modules/webpack/bin/webpack.js --config=node_modules/laravel-mix/setup/webpack.config.js",
    "lint-svg": "cross-env svglint templates/designs/bold/images/*.svg templates/designs/fresh/images/*.svg assets/images/*.svg",
    "lint-js": "cross-env eslint --ext js,vue assets/block-editor/* assets/recipe-editor/* assets/settings/*",
    "lint": "npm run lint-svg && npm run lint-js",
    "lint-fix": "npm run lint -- --fix",
    "makepot": "php -d memory_limit=512M /usr/local/bin/wp i18n make-pot . languages/tasty-recipes-lite.pot --skip-audit",
    "test": "jest",
    "tdd": "jest --watch"
  },
  "dependencies": {
    "vue": "^2.7.4",
    "vue-color": "^2.8.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "vue"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.js$": "babel-jest",
      ".*\\.(vue)$": "vue-jest"
    },
    "roots": [
      "<rootDir>/assets/recipe-editor/",
      "<rootDir>/assets/settings/"
    ]
  }
}
