{
  "name": "tasty-recipes-lite",
  "version": "1.0.0",
  "main": "Gruntfile.js",
  "author": "WP Tasty",
  "devDependencies": {
    "@vue/test-utils": "^1.3",
    "@wordpress/scripts": "^30.19.0",
    "cross-env": "^7.0.3",
    "grunt": "^1.6.1",
    "grunt-contrib-compress": "^2.0.0",
    "grunt-text-replace": "^0.4",
    "ignore-emit-webpack-plugin": "^2.0.6",
    "classnames": "^2.5.1",
    "laravel-mix": "^6.0",
    "svglint": "^4.1.0",
    "vue-html-loader": "^1.2.4",
    "vue-loader": "^15.11.1",
    "vue-template-compiler": "^2.7.16"
  },
  "scripts": {
    "build": "wp-scripts build && npm run mix:build",
    "start": "wp-scripts start && npm run mix:dev",
    "dev": "npm run start",
    "watch": "npm run start",
    "prod": "npm run production",
    "production": "npm run build",
    "wp:build": "wp-scripts build",
    "wp:start": "wp-scripts start",
    "mix:dev": "cross-env NODE_ENV=development node_modules/webpack/bin/webpack.js --progress --config=node_modules/laravel-mix/setup/webpack.config.js",
    "mix:build": "cross-env NODE_ENV=production node_modules/webpack/bin/webpack.js --config=node_modules/laravel-mix/setup/webpack.config.js",
    "lint-svg": "cross-env svglint templates/designs/bold/images/*.svg templates/designs/fresh/images/*.svg assets/images/*.svg",
    "lint-js": "eslint assets/settings && eslint assets/block-editor",
    "lint": "npm run lint-svg && npm run lint-js",
    "lint-fix": "eslint assets/settings --fix && eslint assets/block-editor --fix",
    "makepot": "php -d memory_limit=512M /usr/local/bin/wp i18n make-pot . languages/tasty-recipes.pot --skip-audit",
    "test:php": "composer phpunit",
    "zip": "bin/compile.sh"
  },
  "dependencies": {
    "@wordpress/icons": "^10.26.0",
    "@uiw/react-color-chrome": "^2.7.1",
    "react-select": "^5.10.2",
    "vue": "^2.7",
    "vue-color": "^3.3"
  }
}
