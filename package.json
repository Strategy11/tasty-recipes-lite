{
  "name": "tasty-recipes-lite",
  "version": "3.7.3",
  "main": "Gruntfile.js",
  "author": "WP Tasty",
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.25",
    "@babel/preset-env": "^7.25",
    "@vue/test-utils": "^1.3",
    "@wordpress/eslint-plugin": "^21",
    "autoprefixer": "^10.4",
    "babel-core": "^7.0.0-bridge.0",
    "babel-loader": "^9.2",
    "babel-plugin-transform-react-jsx": "^6.24",
    "css-loader": "^7",
    "cross-env": "^7.0.3",
    "eslint-plugin-vue": "^9",
    "grunt": "^1.6",
    "grunt-text-replace": "^0.4",
    "grunt-wp-readme-to-markdown": "^2.1",
    "jest": "^29.7",
    "jest-environment-jsdom": "^29.7",
    "laravel-mix": "^6.0",
    "postcss": "^8.4",
    "resolve-url-loader": "^5.0",
    "sass": "^1.80",
    "sass-loader": "^16.0",
    "style-loader": "^4.0",
    "svglint": "^3.0",
    "vue-jest": "^3",
    "vue-loader": "^15.11",
    "vue-template-compiler": "^2.7",
    "webpack-notifier": "^1.15"
  },
  "scripts": {
    "build": "npm run prod",
    "dev": "npm run development",
    "development": "cross-env NODE_ENV=development node_modules/webpack/bin/webpack.js --progress --config=node_modules/laravel-mix/setup/webpack.config.js",
    "watch": "npm run development -- --watch",
    "hot": "cross-env NODE_ENV=development node_modules/webpack-dev-server/bin/webpack-dev-server.js --inline --hot --config=node_modules/laravel-mix/setup/webpack.config.js",
    "prod": "npm run production",
    "production": "cross-env NODE_ENV=production node_modules/webpack/bin/webpack.js --config=node_modules/laravel-mix/setup/webpack.config.js",
    "lint-svg": "cross-env svglint templates/designs/bold/images/*.svg templates/designs/fresh/images/*.svg assets/images/*.svg",
    "lint-js": "cross-env eslint --ext js,vue assets/block-editor/* assets/recipe-editor/* assets/settings/* assets/js/*",
    "lint": "npm run lint-svg && npm run lint-js",
    "lint-fix": "npm run lint -- --fix",
    "makepot": "php -d memory_limit=512M /usr/local/bin/wp i18n make-pot . languages/tasty-recipes.pot --skip-audit",
    "test": "jest",
    "test:php": "composer phpunit",
    "tdd": "jest --watch",
    "zip": "bin/compile.sh"
  },
  "dependencies": {
    "vue": "^2.7",
    "vue-color": "^2.8"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "vue"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.js$": "babel-jest",
      ".*\\.(vue)$": "vue-jest"
    },
    "roots": [
      "<rootDir>/assets/recipe-editor/",
      "<rootDir>/assets/settings/"
    ]
  }
}
