{
  "name": "tasty-recipes-lite",
  "version": "1.0.0",
  "main": "Gruntfile.js",
  "author": "WP Tasty",
  "devDependencies": {
    "@wordpress/scripts": "26.15.0",
    "cross-env": "^10.0.0",
    "grunt": "^1.6.1",
    "grunt-text-replace": "^0.4",
    "ignore-emit-webpack-plugin": "^2.0.6",
    "classnames": "^2.5.1",
    "svglint": "^4.1.1"
  },
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "dev": "npm run start",
    "watch": "npm run start",
    "prod": "npm run production",
    "production": "npm run build",
    "lint-svg": "cross-env svglint templates/designs/bold/images/*.svg templates/designs/fresh/images/*.svg assets/images/*.svg",
    "lint-js": "eslint assets/settings && eslint assets/block-editor",
    "lint": "npm run lint-svg && npm run lint-js",
    "lint-fix": "eslint assets/settings --fix && eslint assets/block-editor --fix",
    "makepot": "php -d memory_limit=512M /usr/local/bin/wp i18n make-pot . languages/tasty-recipes.pot --skip-audit",
    "test:php": "composer phpunit",
    "zip": "bin/compile.sh",
    "sync-locks": "pnpm install && npm install --package-lock-only"
  },
  "dependencies": {
    "@wordpress/icons": "^11.0.0",
    "@uiw/react-color-chrome": "^2.9.0",
    "react-select": "^5.10.2"
  }
}
