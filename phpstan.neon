parameters:
	level: 6
	reportUnmatchedIgnoredErrors: true
	treatPhpDocTypesAsCertain: false
	bootstrapFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
		- stubs.php
		- inc/libs/tasty-framework/inc/Traits/Singleton.php
		- inc/libs/tasty-framework/inc/Utils/Vars.php
		- inc/libs/tasty-framework/inc/Utils/Url.php
		- inc/libs/tasty-framework/inc/Abstracts/PluginInstaller.php
		- inc/libs/tasty-framework/inc/Admin/Plugins/Factory.php
	excludePaths:
		- */assets/*
		- */bin/*
		- */class-recipe-graph-piece.php
		- */languages/*
		- */node_modules/*
		- stubs.php
		- */tasty-framework/*
		- templates/*
		- */tests/*
		- */vendor/*
	strictRules:
		booleansInConditions: false
		noVariableVariables: false
	ignoreErrors:
		- '#Access to an undefined property#'
		- '#might not be defined.#'
		- '#Use more strict comparison#'
		- '#no value type specified in iterable type array#'
