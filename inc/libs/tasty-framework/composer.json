{
	"name": "strategy11/tasty-framework",
	"description": "Common functionality between all WP Tasty plugins.",
	"homepage": "https://github.com/Strategy11/tasty-framework",
	"license": "GPL-2.0+",
	"authors": [
		{
			"name": "WP Tasty team",
			"email": "support@wptasty.com",
			"homepage": "https://wptasty.com"
		}
	],
	"type": "wordpress-plugin",
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"support": {
		"issues": "https://github.com/Strategy11/tasty-framework/issues",
		"source": "https://github.com/Strategy11/tasty-framework"
	},
	"require-dev": {
		"php": "^8",
		"automattic/vipwpcs": "^3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^0.7.0",
		"friendsofphp/php-cs-fixer": "^3.54",
		"php-stubs/wordpress-stubs": "^6",
		"phpcompatibility/phpcompatibility-wp": "^2.0",
		"phpstan/extension-installer": "^1.3",
		"phpstan/phpstan": "^1.10",
		"phpstan/phpstan-strict-rules": "^1.5",
		"phpunit/phpunit": "^7.5.20 || ^9",
		"slevomat/coding-standard": "~8.0",
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3",
		"yoast/phpunit-polyfills": "^2"
	},
	"autoload": {},
	"autoload-dev": {
	  "psr-4": {
		"Tasty\\Tests\\": "Tests/"
	  }
	},
	"scripts": {
		"test-unit": "\"vendor/bin/phpunit\" --configuration tests/Unit/phpunit.xml.dist",
		"test-integration": "\"vendor/bin/phpunit\" --configuration tests/Integration/phpunit.xml.dist",
		"run-tests": [
			"@test-unit",
			"@test-integration"
		],
		"install-codestandards": "Dealerdirect\\Composer\\Plugin\\Installers\\PHPCodeSniffer\\Plugin::run",
		"phpcs": "phpcs --basepath=.",
		"phpcs:fix": "phpcbf",
		"phpcsfixer": "vendor/bin/php-cs-fixer fix --dry-run --verbose",
		"phpstan": "vendor/bin/phpstan analyze ./ --memory-limit=2G",
		"post-install-cmd": [
		  "composer dump-autoload"
		],
		"post-update-cmd": [
		  "composer dump-autoload"
		]
	}
}
