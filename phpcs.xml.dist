<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards for Plugins">
	<description>Generally-applicable sniffs for WordPress plugins</description>

	<exclude-pattern>*/inc/class-updater.php</exclude-pattern>
	<exclude-pattern>*/stubs.php</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>*.min.css</exclude-pattern>
	<exclude-pattern>*/css/easyrecipe.css</exclude-pattern>
	<exclude-pattern>*/assets/dist/*</exclude-pattern>

	<!-- Check all PHP files in directory tree by default. -->
	<arg name="extensions" value="php,css"/>
	<file>.</file>

	<!-- Show progress and sniff codes in all reports -->
	<arg value="ps"/>

	<!-- Rules: Check PHP version compatibility -->
	<!-- https://github.com/PHPCompatibility/PHPCompatibility#sniffing-your-code-for-compatibility-with-specific-php-versions -->
	<config name="testVersion" value="5.6-"/>

	<config name="minimum_supported_wp_version" value="5.0"/>

	<!-- https://github.com/PHPCompatibility/PHPCompatibilityWP -->
	<rule ref="PHPCompatibilityWP"/>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/inc/libs/*</exclude-pattern>

	<rule ref="WordPress">
		<exclude name="WordPress.Arrays.ArrayDeclarationSpacing.AssociativeKeyFound" />
		<exclude name="WordPress.NamingConventions.ValidVariableName.NotSnakeCaseMemberVar" />
		<exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase" />
		<exclude name="WordPress.PHP.YodaConditions.NotYoda" />
		<exclude name="Universal.Arrays.DisallowShortArraySyntax.Found" />
	</rule>

	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*/tasty-recipes.php</exclude-pattern>
	</rule>

	<!-- WP-CLI commands are excluded from this rule -->
	<rule ref="Squiz.Commenting.FunctionComment.MissingParamTag">
		<exclude-pattern>*/inc/class-cli.php</exclude-pattern>
	</rule>

	<rule ref="WordPress-Docs" />

	<!-- Rules: Check for unused variables -->
	<rule ref="VariableAnalysis">
		<exclude-pattern>*/templates/*</exclude-pattern>
		<properties>
			<property name="allowUnusedCaughtExceptions" value="true" />
			<property name="allowUnusedForeachVariables" value="true" />
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound" />
		<properties>
			<property name="text_domain" type="array">
				<element value="tasty-recipes"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="tasty_recipes"/>
				<element value="wpt"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.Security.EscapeOutput.UnsafePrintingFunction"/>

	<rule ref="WordPressVIPMinimum">
		<exclude name="WordPressVIPMinimum.Performance.RemoteRequestTimeout.timeout_timeout" />
	</rule>

	<!-- Treat these warnings as errors -->
	<rule ref="Generic.Formatting.MultipleStatementAlignment.NotSameWarning">
		<severity>8</severity>
		<type>error</type>
	</rule>
	<rule ref="WordPress.Arrays.MultipleStatementAlignment.DoubleArrowNotAligned">
		<severity>8</severity>
		<type>error</type>
	</rule>

	<!-- Add some rules from the Slevomat Coding Standard -->
	<rule ref="SlevomatCodingStandard.PHP.UselessParentheses"/>

	<rule ref="SlevomatCodingStandard.Files.LineLength">
		<properties>
			<property name="lineLengthLimit" value="180" />
		</properties>
		<exclude-pattern>templates/*</exclude-pattern>
	</rule>

	<rule ref="SlevomatCodingStandard.Functions.FunctionLength">
		<properties>
			<property name="maxLinesLength" value="100" />
		</properties>
	</rule>

	<rule ref="SlevomatCodingStandard.Files.FileLength">
		<properties>
			<property name="includeComments" value="true" />
			<property name="includeWhitespace" value="true" />
			<property name="maxLinesLength" value="1510" />
		</properties>
		<exclude-pattern>inc/class-distribution-metadata.php</exclude-pattern>
		<exclude-pattern>inc/class-admin.php</exclude-pattern>
		<exclude-pattern>inc/class-shortcodes.php</exclude-pattern>
	</rule>

	<!-- Set rules for Cognitive Complexity -->
	<rule ref="SlevomatCodingStandard.Complexity.Cognitive">
		<properties>
			<property name="warningThreshold" value="35" />
			<property name="errorThreshold" value="10" />
		</properties>
	</rule>
	<rule ref="SlevomatCodingStandard.Complexity.Cognitive.ComplexityTooHigh"/>
</ruleset>
